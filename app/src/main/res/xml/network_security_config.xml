<?xml version="1.0" encoding="utf-8"?>
<!-- Home NAS servers are often reached over plain HTTP on the LAN or inside the VPN,
     and with self-signed certificates; allow both, trust user-installed CAs. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" tools:ignore="AcceptsUserCertificates" />
        </trust-anchors>
    </base-config>
</network-security-config>
